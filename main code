          if(!projectiles[i].active) {
            projectiles[i].x = pizzaX;
            projectiles[i].y = pizzaY;
            projectiles[i].vx = cos(angle) * 2.5;
            projectiles[i].vy = sin(angle) * 2.5;
            projectiles[i].type = 13;
            projectiles[i].active = true;
            break;
          }
        }
      }

      if(upgPotato > 0 && (millis() % 2000 < 200)) {
        for(int i=0; i<96; i++) {
          if(!projectiles[i].active) {
            projectiles[i].x = pizzaX;
            projectiles[i].y = pizzaY;
            projectiles[i].vx = cos(angle) * 4.5;
            projectiles[i].vy = sin(angle) * 4.5;
            projectiles[i].type = 14;
            projectiles[i].active = true;
