          }
        }
      }

      if(upgHotSauce > 0) {
        for(int i=0; i<96; i++) {
          if(!projectiles[i].active) {
            projectiles[i].x = pizzaX;
            projectiles[i].y = pizzaY;
            projectiles[i].vx = cos(angle) * 8.5;
            projectiles[i].vy = sin(angle) * 8.5;
