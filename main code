void setup() {
  Serial.begin(115200);
  pinMode(BUZZER_PIN, OUTPUT);
  SPI.begin(TFT_SCK, TFT_MISO, TFT_MOSI, -1);
  tft.init();
  tft.setRotation(5);
  touch.begin();
  touch.setRotation(1);
  canvas.createSprite(320, 240);
  randomSeed(analogRead(1));
  loadPreferences();
}

void loop() {
  updateTouch();

  if (!touchPressed) {
    lastTouchState = false;
  }

  if (currentGameState == MENU) {
    canvas.fillScreen(TFT_BLACK);
    canvas.setTextSize(2);
    canvas.setTextColor(TFT_WHITE, TFT_BLACK);
    canvas.setCursor(85, 15); canvas.print("ESP32 ARCADE");

    canvas.fillRoundRect(35, 60, 115, 55, 6, TFT_NAVY);
    canvas.setTextSize(1);
    canvas.setCursor(70, 80); canvas.print("WHACK");

    canvas.fillRoundRect(170, 60, 115, 55, 6, TFT_MAROON);
    canvas.setCursor(195, 80); canvas.print("PIZZA HERO");

    canvas.fillRoundRect(100, 135, 120, 45, 6, TFT_DARKGREY);
    canvas.setCursor(132, 150); canvas.print("SETTINGS");

    canvas.pushSprite(0, 0);

    if (touchPressed && !lastTouchState) {
      if (touchX >= 35 && touchX <= 150 && touchY >= 60 && touchY <= 115) { 
        initWhack(); currentGameState = WHACK_MOLE; 
      }
      else if (touchX >= 170 && touchX <= 285 && touchY >= 60 && touchY <= 115) { 
        initPizzaHero(); currentGameState = PIZZA_HERO; 
      }
      else if (touchX >= 100 && touchX <= 220 && touchY >= 135 && touchY <= 180) { 
        currentGameState = SETTINGS; 
      }
      delay(300);
    }
  } 
  else if (currentGameState == SETTINGS) {
    runSettings();
  }
  else if (currentGameState == WHACK_MOLE) {
    runWhack();
    canvas.pushSprite(0, 0);
  }
  else if (currentGameState == WHACK_GAME_OVER) {
    runWhackGameOver();
  }
  else if (currentGameState == PIZZA_HERO) {
    runPizzaGame();
    canvas.pushSprite(0, 0);
  }
  else if (currentGameState == PIZZA_PAUSE) {
    runPizzaPause();
  }
  else if (currentGameState == PIZZA_UPGRADE_WARNING) {
    runPizzaUpgradeWarning();
  }
  else if (currentGameState == PIZZA_UPGRADE) {
    runPizzaUpgrade();
  }
  else if (currentGameState == PIZZA_GAME_OVER) {
    runPizzaGameOver();
  }
  
  delay(30);
}
