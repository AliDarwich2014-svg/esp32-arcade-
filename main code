#include <LovyanGFX.hpp>
#include <SPI.h>
#include <XPT2046_Touchscreen.h>
#include <Preferences.h>

// ==========================================
// 1. HARDWARE CONFIG & PINS
// ==========================================
#define TFT_MOSI  11
#define TFT_MISO  13
#define TFT_SCK   12
#define TFT_CS    10
#define TFT_DC     8
#define TFT_RST    9
#define TOUCH_CS  14
#define TOUCH_IRQ  7
#define BUZZER_PIN 4

class LGFX : public lgfx::LGFX_Device {
  lgfx::Panel_ILI9341 panel;
  lgfx::Bus_SPI bus;
public:
  LGFX() {
    auto cfg = bus.config();
    cfg.spi_host = SPI2_HOST;
    cfg.spi_mode = 0;
    cfg.freq_write = 40000000;
    cfg.pin_sclk = TFT_SCK;
    cfg.pin_mosi = TFT_MOSI;
    cfg.pin_miso = TFT_MISO;
    cfg.pin_dc   = TFT_DC;
    bus.config(cfg);
    panel.setBus(&bus);

    auto p = panel.config();
    p.pin_cs       = TFT_CS;
    p.pin_rst      = TFT_RST;
    p.panel_width  = 320;
    p.panel_height = 240;
    p.memory_width  = 320;
    p.memory_height = 240;
    p.offset_rotation = 1;
    panel.config(p);
    setPanel(&panel);
  }
};

LGFX tft;
LGFX_Sprite canvas(&tft);
XPT2046_Touchscreen touch(TOUCH_CS, TOUCH_IRQ);
Preferences prefs;

// Game States
enum GameState { MENU, SETTINGS, WHACK_MOLE, WHACK_GAME_OVER, PIZZA_HERO, PIZZA_PAUSE, PIZZA_UPGRADE_WARNING, PIZZA_UPGRADE, PIZZA_GAME_OVER };
GameState currentGameState = MENU;

bool touchPressed = false;
int touchX = 0, touchY = 0;
bool lastTouchState = false;

int highScoreWhack = 0;
int highScorePizza = 0;
int soundVolume = 5;

void loadPreferences() {
  prefs.begin("arcade", true);
  highScoreWhack = prefs.getInt("hswhack", 0);
  highScorePizza = prefs.getInt("hspizza", 0);
  soundVolume = prefs.getInt("vol", 5);
  prefs.end();
}

void saveHighScore(String game, int score) {
  prefs.begin("arcade", false);
  if (game == "whack" && score > highScoreWhack) {
    highScoreWhack = score;
    prefs.putInt("hswhack", highScoreWhack);
  } else if (game == "pizza" && score > highScorePizza) {
    highScorePizza = score;
    prefs.putInt("hspizza", highScorePizza);
  }
  prefs.end();
}

void saveVolumeSetting() {
  prefs.begin("arcade", false);
  prefs.putInt("vol", soundVolume);
  prefs.end();
}

void resetHighScores() {
  prefs.begin("arcade", false);
  prefs.clear();
  prefs.end();
  highScoreWhack = 0;
  highScorePizza = 0;
  soundVolume = 5;
}

void playTone(int freq, int duration) {
  if (soundVolume <= 0) return;
  tone(BUZZER_PIN, freq, duration);
}

void updateTouch() {
  if (touch.touched()) {
    TS_Point pt = touch.getPoint();
    touchX = map(pt.x, 200, 3800, 0, 320);
    touchY = map(pt.y, 200, 3800, 0, 240);
    touchX = constrain(touchX, 0, 320);
    touchY = constrain(touchY, 0, 240);
    touchPressed = true;
  } else {
    touchPressed = false;
  }
}

// ==========================================
// 2. GAME: WHACK-A-MOLE
// ==========================================
int moleState[6]; 
unsigned long moleTimer = 0;
unsigned long actionTimer = 0;
int moleScore = 0;
int lives = 3;
int animFrame = 0;

void initWhack() {
  moleScore = 0;
  lives = 3;
  moleTimer = millis();
  for(int i=0; i<6; i++) moleState[i] = 0;
  moleState[random(0, 6)] = 1;
}

void drawMole(int x, int y, int frame) {
  int bobY = y + (frame % 2 == 0 ? -2 : 2);
  canvas.fillCircle(x, bobY, 22, TFT_BROWN);
  canvas.fillCircle(x - 7, bobY - 5, 3, TFT_BLACK);
  canvas.fillCircle(x + 7, bobY - 5, 3, TFT_BLACK);
  canvas.fillEllipse(x, bobY + 4, 6, 4, TFT_LIGHTGREY);
  canvas.fillCircle(x, bobY + 3, 2, TFT_BLACK);
  canvas.drawLine(x - 14, bobY + 2, x - 8, bobY + 4, TFT_BLACK);
  canvas.drawLine(x - 14, bobY + 6, x - 8, bobY + 5, TFT_BLACK);
  canvas.drawLine(x + 8, bobY + 4, x + 14, bobY + 2, TFT_BLACK);
  canvas.drawLine(x + 8, bobY + 5, x + 14, bobY + 6, TFT_BLACK);
}

void drawBomb(int x, int y) {
  canvas.fillCircle(x, y + 2, 20, TFT_DARKGREY);
  canvas.fillRect(x - 3, y - 20, 6, 8, TFT_ORANGE);
  canvas.drawLine(x, y - 20, x + 8, y - 25, TFT_YELLOW);
  canvas.setTextSize(1);
  canvas.setTextColor(TFT_WHITE, TFT_DARKGREY);
  canvas.setCursor(x - 6, y - 4);
  canvas.print("X");
}

void drawExplosion(int x, int y) {
  canvas.fillCircle(x, y, random(15, 28), TFT_RED);
  canvas.fillCircle(x, y, random(8, 16), TFT_ORANGE);
  canvas.fillCircle(x, y, random(3, 8), TFT_YELLOW);
}

void runWhack() {
  canvas.fillScreen(TFT_BLACK);
  canvas.setTextSize(1);
  canvas.setCursor(10, 10); canvas.print("SCORE:"); canvas.print(moleScore);
  canvas.setCursor(90, 10); canvas.print("LIVES:"); canvas.print(lives);
  canvas.setCursor(180, 10); canvas.print("HS:"); canvas.print(highScoreWhack);
  canvas.setCursor(270, 10); canvas.print("EXIT");

  int coords[6][2] = {{60, 70}, {160, 70}, {260, 70}, {60, 150}, {160, 150}, {260, 150}};
  
  bool hasActiveAnimation = false;
  for(int i=0; i<6; i++) {
    if(moleState[i] == 3 || moleState[i] == 4) {
      hasActiveAnimation = true;
      break;
    }
  }
  if (hasActiveAnimation && millis() - actionTimer > 300) {
    for(int i=0; i<6; i++) { 
      if(moleState[i] == 3 || moleState[i] == 4) moleState[i] = 0; 
    }
  }

  for(int i = 0; i < 6; i++) {
    canvas.drawCircle(coords[i][0], coords[i][1], 30, TFT_BLUE);
    if(moleState[i] == 1) drawMole(coords[i][0], coords[i][1], animFrame);
    else if(moleState[i] == 2) drawBomb(coords[i][0], coords[i][1]);
    else if(moleState[i] == 3) drawExplosion(coords[i][0], coords[i][1]);
    else if(moleState[i] == 4) {
      canvas.fillCircle(coords[i][0], coords[i][1] + 8, 14, TFT_BROWN);
      canvas.setTextSize(1);
      canvas.setTextColor(TFT_WHITE, TFT_RED);
      canvas.setCursor(coords[i][0] - 12, coords[i][1] - 20);
      canvas.print("POW!");
    }
  }

  if (touchPressed && !lastTouchState) {
    if (touchY < 30 && touchX > 250) { currentGameState = MENU; delay(300); return; }
    for(int i = 0; i < 6; i++) {
      int dx = touchX - coords[i][0];
      int dy = touchY - coords[i][1];
      if(dx * dx + dy * dy < 900) {
        if(moleState[i] == 1) {
          moleScore += 10;
          saveHighScore("whack", moleScore);
          moleState[i] = 4;
          actionTimer = millis();
          playTone(600, 50);
        } else if(moleState[i] == 2) {
          lives--;
          moleState[i] = 3;
          actionTimer = millis();
          playTone(150, 100);
          if(lives <= 0) {
            currentGameState = WHACK_GAME_OVER;
            delay(300);
            return;
          }
        }
      }
    }
  }

  int activeTime = max(500, (int)(1000 - (moleScore * 0.8))); 
  int bombChance = min(40, 15 + (moleScore / 20)); 

  if(millis() - moleTimer > activeTime) {
    for(int i=0; i<6; i++) { if(moleState[i] != 3 && moleState[i] != 4) moleState[i] = 0; }
    int target = random(0, 6);
    moleState[target] = (random(0, 100) < bombChance) ? 2 : 1;
    moleTimer = millis();
    animFrame++;
  }
}

void runWhackGameOver() {
  canvas.fillScreen(TFT_BLACK);
  canvas.setTextSize(2);
  canvas.setTextColor(TFT_RED, TFT_BLACK);
  canvas.setCursor(80, 40); canvas.print("GAME OVER");

  canvas.setTextSize(1);
  canvas.setTextColor(TFT_WHITE, TFT_BLACK);
  canvas.setCursor(90, 90); canvas.print("Final Score: "); canvas.print(moleScore);
  canvas.setCursor(90, 115); canvas.print("High Score:  "); canvas.print(highScoreWhack);

  canvas.fillRoundRect(80, 155, 160, 40, 6, TFT_MAROON);
  canvas.setCursor(120, 168); canvas.print("MAIN MENU");

  canvas.pushSprite(0, 0);

  if (touchPressed && !lastTouchState) {
    if (touchX >= 80 && touchX <= 240 && touchY >= 155 && touchY <= 195) {
      currentGameState = MENU;
      delay(300);
    }
  }
}

// ==========================================
// 3. GAME: PIZZA HERO ROGUELIKE
// ==========================================
float pizzaX = 160, pizzaY = 120;
int pizzaHP = 100;
int pizzaMaxHP = 100;
int pizzaXP = 0;
int pizzaLevel = 1;
int nextLevelXP = 50;
int pizzaWave = 1;

// Upgrades / Toppings (20 total)
int upgPepperoni = 0; 
int upgMushroom = 0;  
int upgOlive = 0;     
int upgBacon = 0;     
int upgGarlic = 0;    
int upgCheese = 0;    
int upgCrust = 0;     
int upgSausage = 0;   
int upgBasil = 0;     
int upgMagnet = 0;
int upgKnifeSpin = 0; 
int upgPineapple = 0;
int upgOnion = 0;
int upgJalapeno = 0;
int upgTruffle = 0;
int upgAnchovy = 0;
int upgHoney = 0;
int upgPotato = 0;
int upgHotSauce = 0;
int upgMarshmallow = 0;

int currentRandomUpgrades[3] = {0, 0, 0};

// Enemy Structure
struct Enemy {
  float x, y;
  int hp;
  int maxHp;
  int type; // 0=Fork, 1=Knife, 2=Pizza Cutter, 3=Spoon, 4=Whisk, 5=Cookware Boss, 6=Salt Shaker (Ranged), 7=Rolling Pin (Ranged)
  bool active;
  unsigned long lastShot;
};
Enemy enemies[24];

bool bossActive = false;
bool megaBossActive = false;
bool megaBossSpawnedThisRun = false; // Flag to guarantee the mega boss only spawns once per game session

// Mega Boss Structure
struct MegaBoss {
  float x, y;
  int hp;
  int maxHp;
  bool active;
  unsigned long attackCooldown;
} megaBoss;

unsigned long megaBossFireTick = 0;

// Projectiles Structure
struct Projectile {
  float x, y;
  float vx, vy;
  int type; 
  bool active;
};
Projectile projectiles[96];

// Area Effect Visual Indicators struct
struct AreaEffect {
  float x, y;
  float radius;
  uint16_t color;
  int duration; 
  bool active;
};
AreaEffect areaEffects[16];

// XP Gems & Magnet Item
struct Gem {
  float x, y;
  int type; 
  bool active;
};
Gem gems[32];

struct MagnetItem {
  float x, y;
  bool active;
};
MagnetItem mapMagnet;

bool magnetSpawnedOnce = false;
unsigned long bossFireTick = 0;

// Knife Spin Timers
unsigned long knifeSpinActiveTimer = 0;
unsigned long knifeSpinCooldownTimer = 0;
bool knifeSpinIsActive = false;

void initPizzaHero() {
  pizzaX = 160; pizzaY = 120;
  pizzaHP = 100; pizzaMaxHP = 100;
  pizzaXP = 0; pizzaLevel = 1; nextLevelXP = 50; pizzaWave = 1;
  upgPepperoni = 0; upgMushroom = 0; upgOlive = 0; upgBacon = 0; upgGarlic = 0; 
  upgCheese = 0; upgCrust = 0; upgSausage = 0; upgBasil = 0; upgMagnet = 0; upgKnifeSpin = 0; 
  upgPineapple = 0; upgOnion = 0; upgJalapeno = 0; upgTruffle = 0; upgAnchovy = 0; upgHoney = 0;
  upgPotato = 0; upgHotSauce = 0; upgMarshmallow = 0;
  bossActive = false;
  megaBossActive = false;
  megaBossSpawnedThisRun = false;
  megaBoss.active = false;
  magnetSpawnedOnce = false;
  mapMagnet.active = false;
  bossFireTick = millis();
  megaBossFireTick = millis();
  knifeSpinActiveTimer = 0;
  knifeSpinCooldownTimer = millis();
  knifeSpinIsActive = false;
  
  for(int i=0; i<24; i++) enemies[i].active = false;
  for(int i=0; i<96; i++) projectiles[i].active = false;
  for(int i=0; i<32; i++) gems[i].active = false;
  for(int i=0; i<16; i++) areaEffects[i].active = false;
}

unsigned long lastShotTick = 0;
unsigned long spawnTick = 0;

void runPizzaGame() {
  canvas.fillScreen(TFT_BLACK);

  for(int x = 0; x < 320; x += 40) canvas.drawLine(x, 0, x, 240, lgfx::color565(30, 30, 45));
  for(int y = 0; y < 240; y += 40) canvas.drawLine(0, y, 320, y, lgfx::color565(30, 30, 45));

  // Render Persistent Area Effects
  for(int a=0; a<16; a++) {
    if(areaEffects[a].active) {
      canvas.drawCircle(areaEffects[a].x, areaEffects[a].y, areaEffects[a].radius, areaEffects[a].color);
      canvas.drawCircle(areaEffects[a].x, areaEffects[a].y, areaEffects[a].radius - 1, areaEffects[a].color);
      
      areaEffects[a].duration--;
      if(areaEffects[a].duration <= 0) {
        areaEffects[a].active = false;
      }
    }
  }

  // Touch Movement
  if (touchPressed) {
    if (touchY < 25 && touchX > 270) {
      if (!lastTouchState) {
        currentGameState = PIZZA_PAUSE;
        lastTouchState = true;
        delay(200);
        return;
      }
    } else {
      float moveSpeed = 1.6 + (upgCrust * 0.4);
      if (touchX < pizzaX) pizzaX -= moveSpeed;
      if (touchX > pizzaX) pizzaX += moveSpeed;
      if (touchY < pizzaY) pizzaY -= moveSpeed;
      if (touchY > pizzaY) pizzaY += moveSpeed;
    }
  }
  pizzaX = constrain(pizzaX, 20, 300);
  pizzaY = constrain(pizzaY, 30, 220);

  // Marshmallow Shield White Ring Indicator Around Player
  if (upgMarshmallow > 0) {
    float shieldRadius = 16 + (upgMarshmallow * 3);
    canvas.drawCircle(pizzaX, pizzaY, shieldRadius, TFT_WHITE);
  }

  // Magnet spawn logic
  if (pizzaLevel >= 7 && !magnetSpawnedOnce && !mapMagnet.active) {
    mapMagnet.x = random(40, 280);
    mapMagnet.y = random(40, 200);
    mapMagnet.active = true;
    magnetSpawnedOnce = true;
  }

  if (mapMagnet.active) {
    canvas.fillCircle(mapMagnet.x, mapMagnet.y, 8, TFT_MAGENTA);
    canvas.fillCircle(mapMagnet.x, mapMagnet.y, 4, TFT_WHITE);
    canvas.setTextSize(1);
    canvas.setTextColor(TFT_MAGENTA, TFT_BLACK);
    canvas.setCursor(mapMagnet.x - 12, mapMagnet.y - 14);
    canvas.print("MAG");

    float dx = pizzaX - mapMagnet.x;
    float dy = pizzaY - mapMagnet.y;
    if (dx*dx + dy*dy < 400) {
      mapMagnet.active = false;
      upgMagnet = max(1, upgMagnet);
      playTone(800, 100);
    }
  }

  // Knife Spin Topping Logic
  if (upgKnifeSpin > 0) {
    unsigned long currentMillis = millis();
    if (!knifeSpinIsActive && currentMillis - knifeSpinCooldownTimer >= 1000) {
      knifeSpinIsActive = true;
      knifeSpinActiveTimer = currentMillis;
    }
    if (knifeSpinIsActive) {
      if (currentMillis - knifeSpinActiveTimer >= 1000) {
        knifeSpinIsActive = false;
        knifeSpinCooldownTimer = currentMillis;
      } else {
        int knifeCount = 4 + (upgKnifeSpin * 2);
        float spinAngleOffset = (currentMillis / 100.0);
        float spinRadius = 25 + (upgKnifeSpin * 6);
        for(int k=0; k<knifeCount; k++) {
          float ang = spinAngleOffset + (k * (6.28 / knifeCount));
          float kx = pizzaX + cos(ang) * spinRadius;
          float ky = pizzaY + sin(ang) * spinRadius;
          canvas.fillCircle(kx, ky, 3, TFT_WHITE);
          
          for(int e=0; e<24; e++) {
            if(enemies[e].active) {
              float edx = enemies[e].x - kx;
              float edy = enemies[e].y - ky;
              if(edx*edx + edy*edy < 144) {
                enemies[e].hp -= (4 + upgKnifeSpin * 3);
                if(enemies[e].hp <= 0) {
                  enemies[e].active = false;
                  if(enemies[e].type == 5) bossActive = false;
                  for(int g=0; g<32; g++) {
                    if(!gems[g].active) {
                      gems[g].x = enemies[e].x;
                      gems[g].y = enemies[e].y;
                      gems[g].type = (enemies[e].type == 5) ? 1 : 0; 
                      gems[g].active = true;
                      break;
                    }
                  }
                }
              }
            }
          }
          if (megaBoss.active) {
            float mdx = megaBoss.x - kx;
            float mdy = megaBoss.y - ky;
            if(mdx*mdx + mdy*mdy < 400) {
              megaBoss.hp -= (3 + upgKnifeSpin * 2);
              if(megaBoss.hp <= 0) {
                megaBoss.active = false;
                megaBossActive = false;
                for(int g=0; g<32; g++) {
                  if(!gems[g].active) {
                    gems[g].x = megaBoss.x;
                    gems[g].y = megaBoss.y + 40;
                    gems[g].type = 2; 
                    gems[g].active = true;
                    break;
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // Automatic Firing
  int baseFireInterval = max(150, 550 - (upgSausage * 70) - ((upgPepperoni + upgMushroom + upgBacon) * 25));
  float effectiveRange = 140.0 + (upgBasil * 40.0);
  float maxRangeSq = effectiveRange * effectiveRange;

  if (millis() - lastShotTick > baseFireInterval) {
    int nearest = -1;
    float minDist = 99999;
    for(int i=0; i<24; i++) {
      if(enemies[i].active) {
        float d = pow(enemies[i].x - pizzaX, 2) + pow(enemies[i].y - pizzaY, 2);
        if(d < minDist) { minDist = d; nearest = i; }
      }
    }
    if (megaBoss.active && (minDist > pow(megaBoss.x - pizzaX, 2) + pow(megaBoss.y - pizzaY, 2))) {
      nearest = -1; 
    }
    
    if(nearest != -1 && minDist <= maxRangeSq) {
      float angle = atan2(enemies[nearest].y - pizzaY, enemies[nearest].x - pizzaX);
      
      int pepCount = 1 + upgPepperoni; 
      for(int p=0; p<pepCount; p++) {
        float spreadAngle = angle + (p * 0.25) - ((pepCount - 1) * 0.125);
        for(int i=0; i<96; i++) {
          if(!projectiles[i].active) {
            projectiles[i].x = pizzaX;
            projectiles[i].y = pizzaY;
            projectiles[i].vx = cos(spreadAngle) * 5.0;
            projectiles[i].vy = sin(spreadAngle) * 5.0;
            projectiles[i].type = 0;
            projectiles[i].active = true;
            break;
          }
        }
      }

      int mushCount = 1 + (upgMushroom > 1 ? upgMushroom - 1 : 0);
      for(int m=0; m<mushCount; m++) {
        float mAngle = angle + (m * 0.2) - ((mushCount - 1) * 0.1);
        for(int i=0; i<96; i++) {
          if(!projectiles[i].active) {
            projectiles[i].x = pizzaX;
            projectiles[i].y = pizzaY;
            projectiles[i].vx = cos(mAngle) * 8.0;
            projectiles[i].vy = sin(mAngle) * 8.0;
            projectiles[i].type = 1;
            projectiles[i].active = true;
            break;
          }
        }
      }

      if(upgOlive > 0) {
        for(int o=0; o<upgOlive; o++) {
          for(int i=0; i<96; i++) {
            if(!projectiles[i].active) {
              projectiles[i].x = pizzaX;
              projectiles[i].y = pizzaY;
              projectiles[i].vx = cos(angle) * 3.0;
              projectiles[i].vy = sin(angle) * 3.0;
              projectiles[i].type = 2;
              projectiles[i].active = true;
              break;
            }
          }
        }
      }

      if(upgBacon > 0) {
        int baconLines = 2 + (upgBacon * 2);
        for(int b=0; b<baconLines; b++) {
          float bAngle = angle + (((float)b / (baconLines - 1)) * 0.8) - 0.4;
          for(int i=0; i<96; i++) {
            if(!projectiles[i].active) {
              projectiles[i].x = pizzaX;
              projectiles[i].y = pizzaY;
              projectiles[i].vx = cos(bAngle) * 4.5;
              projectiles[i].vy = sin(bAngle) * 4.5;
              projectiles[i].type = 3;
              projectiles[i].active = true;
              break;
            }
          }
        }
      }

      if(upgPineapple > 0 && (millis() % 2000 < 200)) {
        for(int p=0; p<8; p++) {
          float pAngle = p * (6.28 / 8.0);
          for(int i=0; i<96; i++) {
            if(!projectiles[i].active) {
              projectiles[i].x = pizzaX;
              projectiles[i].y = pizzaY;
              projectiles[i].vx = cos(pAngle) * 3.5;
              projectiles[i].vy = sin(pAngle) * 3.5;
              projectiles[i].type = 6;
              projectiles[i].active = true;
              break;
            }
          }
        }
      }

      if(upgOnion > 0) {
        int onionCount = 3 + (upgOnion * 2);
        for(int o=0; o<onionCount; o++) {
          float oAngle = angle + (o * (1.57 / onionCount)) - 0.78;
          for(int i=0; i<96; i++) {
            if(!projectiles[i].active) {
              projectiles[i].x = pizzaX;
              projectiles[i].y = pizzaY;
              projectiles[i].vx = cos(oAngle) * 6.5;
              projectiles[i].vy = sin(oAngle) * 6.5;
              projectiles[i].type = 7;
              projectiles[i].active = true;
              break;
            }
          }
        }
      }

      if(upgJalapeno > 0) {
        for(int j=0; j<2; j++) {
          float jAngle = angle + random(-20, 20) / 100.0;
          for(int i=0; i<96; i++) {
            if(!projectiles[i].active) {
              projectiles[i].x = pizzaX;
              projectiles[i].y = pizzaY;
              projectiles[i].vx = cos(jAngle) * 9.0;
              projectiles[i].vy = sin(jAngle) * 9.0;
              projectiles[i].type = 8;
              projectiles[i].active = true;
              break;
            }
          }
        }
      }

      if(upgTruffle > 0 && (millis() % 3000 < 200)) {
        for(int i=0; i<96; i++) {
          if(!projectiles[i].active) {
            projectiles[i].x = pizzaX;
            projectiles[i].y = pizzaY;
            projectiles[i].vx = 0;
            projectiles[i].vy = 0;
            projectiles[i].type = 11;
            projectiles[i].active = true;
            break;
          }
        }
      }

      if(upgAnchovy > 0) {
        for(int i=0; i<96; i++) {
          if(!projectiles[i].active) {
            projectiles[i].x = pizzaX;
            projectiles[i].y = pizzaY;
