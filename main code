      }
    }

    lastShotTick = millis();
    playTone(300, 30);
  }

  // Garlic Aura
  if(upgGarlic > 0) {
    float auraRadius = 35 + (upgGarlic * 15);
    canvas.drawCircle(pizzaX, pizzaY, auraRadius, TFT_GREEN);
    canvas.drawCircle(pizzaX, pizzaY, auraRadius + 1, TFT_GREEN);

    for(int e=0; e<24; e++) {
      if(enemies[e].active) {
        float dx = enemies[e].x - pizzaX;
        float dy = enemies[e].y - pizzaY;
        if(dx*dx + dy*dy < auraRadius * auraRadius) {
          enemies[e].hp -= (6 + upgGarlic * 6);
          if(enemies[e].hp <= 0) {
            enemies[e].active = false;
            if(enemies[e].type == 5) bossActive = false;
            for(int g=0; g<32; g++) {
              if(!gems[g].active) {
